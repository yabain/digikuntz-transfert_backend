<html>
<head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <meta content="telephone=no" name="format-detection">
    <title>Verification code — digiKUNTZ Payments</title>
    <style type="text/css">
        body {
            margin: 0;
            padding: 0;
            background-color: #F6F6F6;
            font-family: arial, 'helvetica neue', helvetica, sans-serif;
        }
        .wrapper {
            width: 100%;
            table-layout: fixed;
            background-color: #F6F6F6;
        }
        .card {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 8px;
        }
        .code {
            font-size: 36px;
            font-weight: 700;
            letter-spacing: 10px;
            color: #18078d;
            text-align: center;
            padding: 20px;
            background-color: #f0f0fa;
            border-radius: 6px;
        }
        .footer {
            text-align: center;
            color: #666666;
            font-size: 12px;
            padding: 20px;
        }
    </style>
</head>
<body>
    <table class="wrapper" cellpadding="0" cellspacing="0" width="100%">
        <tbody>
            <tr>
                <td align="center" style="padding:20px">
                    <table class="card" cellpadding="0" cellspacing="0" width="100%">
                        <tbody>
                            <tr>
                                <td align="center" style="padding:20px">
                                    <h1 style="margin:0;color:#18078d;font-size:24px">digiKUNTZ Payments</h1>
                                </td>
                            </tr>
                            <tr>
                                <td align="center" style="padding:0 30px">
                                    <h2 style="margin:0 0 10px;color:#333333;font-size:18px">Two-factor verification</h2>
                                    <p style="margin:0;color:#333333;font-size:14px;line-height:21px">
                                        Hello <b>{{userName}}</b>,<br>
                                        Use the code below to confirm your sign-in.
                                    </p>
                                </td>
                            </tr>
                            <tr>
                                <td align="center" style="padding:20px 30px 0">
                                    <div class="code">{{code}}</div>
                                </td>
                            </tr>
                            <tr>
                                <td align="center" style="padding:20px 30px">
                                    <p style="margin:0;color:#666666;font-size:12px;line-height:18px">
                                        This code is valid for 5 minutes. If you did not try to sign in, ignore this
                                        email.
                                    </p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table cellpadding="0" cellspacing="0" width="100%">
                        <tbody>
                            <tr>
                                <td class="footer">
                                    Copyright &copy; 2025 digiKUNTZ. All rights reserved.<br>
                                    Entr&eacute;e ELECAM, Bangangt&eacute;, West Cameroon<br>
                                    support@digikuntz.cm
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</body>
</html>