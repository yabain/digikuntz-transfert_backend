# ── DigiKuntz Payment Backend — variables d'environnement ──────────────
# Copier ce fichier en `.env` puis renseigner les valeurs. Aucun secret réel
# n'est versionné : ce fichier ne contient que des placeholders et les flags
# de configuration à valeur sûre par défaut.

# Base de données MongoDB (chaîne de connexion).
DB_URL=mongodb://localhost:27017/digikuntz-payments

# URL du front (redirections post-paiement, liens de checkout).
FRONT_URL=https://app.example.com

# URL publique du backend — utilisée comme `notifUrl` par les débits natifs
# Orange Cameroun (callback `/orange-cm/notify`, endpoint PUBLIC).
BACK_URL=https://api.example.com

# Environnement applicatif.
NODE_ENV=development

# Sécurité : secrets de la plateforme (JWT, cryptage).
JWT_SECRET=change-me
JWT_EXPIRES=7d
CRYPT_KEY=change-me

# ── Chemin de charge directe Flutterwave (mobile money, sans interface) ──
# Levier de rollback : laissé à false, tout encaissement mobile money repasse
# par le checkout hébergé historique.
DIRECT_CHARGE_ENABLED=false
# Repli vers l'hébergé sur rejet PRÉ-charge uniquement (jamais sur erreur ambiguë).
DIRECT_CHARGE_FALLBACK_HOSTED=true
# Fenêtre (minutes) avant clôture d'un payin direct resté `pending`.
DIRECT_CHARGE_CLOSE_MINUTES=30

# ── Chemin natif Cameroun (Orange CM / MTN CM) — PARALLÈLE ───────────────
# Levier de rollback : laissé à false, une méthode payeur pointant vers une
# passerelle `orange_cm`/`mtn_cm` continue d'emprunter le chemin Flutterwave
# historique. À true, le débit passe par les API natives (persist-then-charge,
# flow `native_cm`), avec vérification des préfixes opérateur avant tout appel.
NATIVE_PAYIN_ENABLED=false
# Fenêtre (minutes) avant clôture d'un payin natif resté `pending` par le cron
# de réconciliation (`cron:payin:native`).
NATIVE_CM_CLOSE_MINUTES=30

# NOTE — secrets Orange/MTN : ils ne vivent PAS dans ce fichier. Les
# credentials des passerelles natives (OM_API_*, MOMO_API_*) sont portés par le
# document `Gateway` correspondant (`Gateway.credentials`, chiffré en base via
# CRYPT_KEY) et chargés par type de passerelle côté serveur.